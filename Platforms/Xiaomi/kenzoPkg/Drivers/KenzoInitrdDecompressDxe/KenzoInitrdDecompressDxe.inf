## @file
#  Decompresses an LZMA-packed ("KLZM") FAT32 initrd from LittleKernel's
#  0x82000000..0x83000000 16 MiB window into high DRAM (0xA0000000) and
#  updates /chosen/linux,initrd-{start,end} in-place before UniXNURamDiskDxe.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION                    = 0x00010019
  BASE_NAME                      = KenzoInitrdDecompressDxe
  FILE_GUID                      = 8E4C1B2A-6F39-4D12-9A7B-5C8E0F1234AB
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = KenzoInitrdDecompressEntry

[Sources]
  KenzoInitrdDecompressDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  FdtLib
  HobLib
  IoLib
  MemoryAllocationLib
  UefiDriverEntryPoint

[Depex]
  TRUE
